# pair_style ace throughput input, VIRIAL ON EVERY STEP.
#
# Identical to in.bench_ace except `thermo 1`.  Why it exists: LAMMPS only asks a pair style
# for the virial on steps whose output needs it, so with `thermo 50` that is 2 steps in 100.
# Since Task 6 the plugin calls the cheaper `ace_site_energy_forces` entry on the other 98,
# which is a real improvement but is NOT part of the evaluation kernel -- and every row taken
# before Task 6 measured a plugin that computed the virial on all 100.  Timing a Task 6
# library with THIS input reproduces the pre-Task-6 workload, so the two rows together
# separate "the kernel got faster" from "the virial is now skipped when it is not wanted".
#
#   -var box <box file>  -var lib <libace*.so>  -var plugin <aceplugin.so>  -var steps <n>
include ${box}
plugin load ${plugin}
pair_style ace
pair_coeff * * ${lib} ${species}
velocity all create 300.0 4928459
fix 1 all nve
timestep 0.0
thermo 1
run ${steps}
